# What reaches Vercel's build machine. Patterns follow gitignore semantics, so a
# bare name matches at ANY depth — anchor every path with a leading slash. A
# pattern like `assets/` deleted backend/assets/fonts, which the renderer needs.
.venv/
node_modules/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
/.pytest_cache/
/data/
/logs/
/*.log
/src-tauri/
/coverage/

# Tests are not imported at runtime and `backend/tests` alone is 17 MB of the
# function budget.
/backend/tests/
/tests/

# A duplicate 17 MB CJK font; the renderer uses NotoSansSC.ttf.
/backend/assets/fonts/NotoSansSC-Medium.ttf
